# Public URL of the site, used for canonical links, Open Graph and the sitemap.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev mode (no cloud account required)
DEV_OWNER_EMAIL=dev-owner@example.com
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=1

# Production Supabase auth/storage values are intentionally omitted here.
