# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site, used for canonical links, Open Graph and the sitemap.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase secret key; server only, bypasses RLS.
SUPABASE_SECRET_KEY=
# Postgres connection string, used by migrations and server-side queries.
DATABASE_URL=
# Output of npm run owner:hash-password. Never the password itself.
# In .env.local, escape each "$" as "\$" so Next.js doesn't expand it; in Vercel paste it as is.
OWNER_PASSWORD_HASH=

# Resend API key for transactional email.
RESEND_API_KEY=
# Sender address, e.g. "SME Auto & HD Truck <noreply@example.com>".
EMAIL_FROM=

# Stripe secret key (use a test key locally).
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Offer ACH bank transfer at checkout (true/false).
STRIPE_ENABLE_ACH=false
# Largest payment request allowed, in cents ($10,000.00).
PAYMENT_MAX_CENTS=1000000

# Cloudflare's public test keys (always pass). Real keys come from #8.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random secret used to hash visitor IPs for rate limiting and spam checks.
IP_HASH_SALT=
